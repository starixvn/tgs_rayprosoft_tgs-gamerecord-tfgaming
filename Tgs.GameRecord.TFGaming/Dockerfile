#See https://aka.ms/customizecontainer to learn how to customize your debug container and how Visual Studio uses this Dockerfile to build your images for faster debugging.

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
USER app
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["nuget.config", "."]
COPY ["Tgs.GameRecord.TFGaming/Tgs.GameRecord.TFGaming.csproj", "Tgs.GameRecord.TFGaming/"]
COPY ["Tgs.GameRecord.TFGaming.Core/Tgs.GameRecord.TFGaming.Core.csproj", "Tgs.GameRecord.TFGaming.Core/"]
COPY ["Tgs.GameRecord.TFGaming.Common/Tgs.GameRecord.TFGaming.Common.csproj", "Tgs.GameRecord.TFGaming.Common/"]
RUN dotnet restore "./Tgs.GameRecord.TFGaming/./Tgs.GameRecord.TFGaming.csproj"
COPY . .
WORKDIR "/src/Tgs.GameRecord.TFGaming"
RUN dotnet build "./Tgs.GameRecord.TFGaming.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "./Tgs.GameRecord.TFGaming.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Tgs.GameRecord.TFGaming.dll"]